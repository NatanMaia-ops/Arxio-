staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs' '*.cjs' '*.json' '*.jsonc' '*.css' '*.md' '*.mdx')

if [ -n "$staged" ]; then
	printf '%s\n' "$staged" | xargs npx @biomejs/biome format --write --no-errors-on-unmatched
	printf '%s\n' "$staged" | xargs git add
fi
